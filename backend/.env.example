# DeepSeek（LLM）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tavily（搜索）
TAVILY_API_KEY=

# PostgreSQL（pgvector，用 docker compose 启动）
DB_URL=postgresql://deepsearch:deepsearch@localhost:5432/deepsearch

# Embedding（本地 BGE，中文小模型 512 维）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# 国内下载模型慢时，取消下面注释启用镜像
# HF_ENDPOINT=https://hf-mirror.com

# Agent 配置
MAX_AGENT_STEPS=8
